{
  "name": "dsh-sendcomfy",
  "version": "0.5.3",
  "private": false,
  "description": "ComfyUI bridge plugin for DeepSeek Harness (DSH): browse ComfyUI server workflows and models from the sidebar, and let the session model pick, parametrize, and run workflows on demand — no import step.",
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "bin",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md",
    "FEATURES.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "comfyui",
    "stable-diffusion",
    "workflow",
    "plugin",
    "agent",
    "txt2img",
    "img2img"
  ],
  "homepage": "https://github.com/catodm/dsh-sendcomfy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catodm/dsh-sendcomfy.git"
  },
  "bugs": {
    "url": "https://github.com/catodm/dsh-sendcomfy/issues"
  },
  "bin": {
    "sendcomfy": "bin/sendcomfy.mjs"
  },
  "scripts": {
    "prepublishOnly": "node --check client.js && node --check index.js"
  }
}
